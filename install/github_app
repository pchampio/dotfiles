#!/bin/bash

BASEDIR=$(dirname $0)
. $BASEDIR/inc/functions

FILTER="${1:-$FILTER}"

# Rex, the session server behind tm (WezTerm Rex). Not on GitHub: the snapshot
# channel lists one build per OS and architecture, with its sha256.
install_rex() {
    local manifest="https://blob.superlogical.com/api/releases/rex/snapshot"
    local dir="$HOME/.local/bin/rex-bin"
    [ -n "$FILTER" ] && [ "$FILTER" != rex ] && return 0
    explain "Installation of rex"
    local release
    release=$(curl -fsSL "$manifest" | python3 -c '
import json, platform, sys
release = json.load(sys.stdin)
system = platform.system().lower()
arch = {"x86_64": "amd64", "aarch64": "arm64"}.get(platform.machine(), platform.machine())
builds = [a for a in release["artifacts"] if a["os"] == system and a["arch"] == arch
          and a["filename"].endswith((".tar.gz", ".zip"))]
builds.sort(key=lambda a: not a["filename"].endswith(".tar.gz"))
if not builds:
    sys.exit("rex: no %s-%s build in the snapshot release" % (system, arch))
print(release["version"], builds[0]["sha256"], builds[0]["downloadUrl"])
') || { error "rex: cannot read $manifest"; return 1; }
    local version sum url
    read -r version sum url <<< "$release"
    if [ -x "$dir/rex" ] && [ "$(cat "$dir/version" 2>/dev/null)" = "$version" ]; then
        explain2 "rex $version is installed already"
        return 0
    fi
    local tmp
    tmp=$(mktemp -d) || return 1
    (
        cd "$tmp" || exit 1
        wget -q --show-progress "$url" || exit 1
        echo "$sum  ${url##*/}" | sha256sum -c --quiet || exit 1
        case $url in
            *.tar.gz) tar xzf "${url##*/}" ;;
            *.zip) unzip -qq "${url##*/}" ;;
        esac
        [ -f rex ] && chmod a+x rex
    ) || { error "rex: download or checksum failed"; rm -rf "$tmp"; return 1; }
    mkdir -p "$dir" || return 1
    # A running Rex server keeps its old binary until it restarts.
    mv -f "$tmp/rex" "$dir/rex.new" && mv -f "$dir/rex.new" "$dir/rex" || return 1
    echo "$version" > "$dir/version"
    rm -rf "$tmp"
    ln -sfn "$dir/rex" "$HOME/.local/bin/rex"
    explain2 "rex $version"
}

# nvtop's own prebuilt AppImage, unpacked once: it runs without FUSE and
# without compiling nvtop.
install_nvtop() {
    local dir="$HOME/.local/bin/nvtop-bin"
    [ -n "$FILTER" ] && [ "$FILTER" != nvtop ] && return 0
    explain "Installation of nvtop"
    local url
    url=$(curl -fsSL "https://api.github.com/repos/Syllo/nvtop/releases/latest" \
          | grep -o "https://[^\"]*-$(uname -m)\.AppImage" | head -1)
    [ -n "$url" ] || { error "nvtop: no $(uname -m) AppImage in the latest release"; return 1; }
    if [ -x "$dir/AppRun" ] && [ "$(cat "$dir/version" 2>/dev/null)" = "$url" ]; then
        explain2 "nvtop ${url##*/} is installed already"
        return 0
    fi
    local tmp
    tmp=$(mktemp -d) || return 1
    (
        cd "$tmp" || exit 1
        wget -q --show-progress "$url" -O nvtop.AppImage || exit 1
        chmod a+x nvtop.AppImage
        ./nvtop.AppImage --appimage-extract >/dev/null || exit 1
        [ -x squashfs-root/AppRun ]
    ) || { error "nvtop: download or unpacking failed"; rm -rf "$tmp"; return 1; }
    rm -rf "$dir" && mv "$tmp/squashfs-root" "$dir" || return 1
    echo "$url" > "$dir/version"
    rm -rf "$tmp"
    rm -f "$HOME/.local/bin/nvtop"
    printf '#!/bin/sh\nexec "%s/AppRun" "$@"\n' "$dir" > "$HOME/.local/bin/nvtop"
    chmod a+x "$HOME/.local/bin/nvtop"
    explain2 "nvtop ${url##*/}"
}

success "[Github APP] Start"

if [ -n "$FILTER" ]; then
    explain "Filtering for app: $FILTER"
fi

install_github_app pinentry "pchampio/build-static-pinentry" "https.*pinentry.*stripped.gz$" &
install_github_app difft "Wilfred/difftastic" "https.*difft.*x86_64.*musl.*gz$" &
install_github_app diff-so-fancy "so-fancy/diff-so-fancy" "https.*diff-so-fancy$" &
install_github_app gotty "yudai/gotty" "https.*gotty.*linux.*amd64.*.gz" &
install_github_app fd "sharkdp/fd" "https.*fd.*x86_64.*musl.*gz$" &
install_github_app rg "BurntSushi/ripgrep" "https.*ripgrep.*x86_64.*musl.*gz$" &
install_github_app atuin "atuinsh/atuin" "https.*atuin-x86_64.*linux-musl.*gz$" &
install_github_app "rbw,rbw-agent" "pchampio/build-static-rbw" "https.*rbw-enhanced-linux-amd64\.tar\.gz$" &
install_github_app fzf "junegunn/fzf" "https.*fzf.*linux.*amd64.*gz$" &
install_github_app jq "jqlang/jq" "https.*jq.*linux-amd64$" &
install_github_app gh "cli/cli" "https.*gh_.*linux_amd64\.tar\.gz$" &
install_github_app pi "badlogic/pi-mono" "https.*pi-linux-x64.*gz$" &
install_github_app qrterminal "mdp/qrterminal" "https.*qrterminal_Linux_x86_64\.tar\.gz$" &
install_github_app btop "aristocratos/btop" "https.*btop-$(uname -m)-unknown-linux-musl\.tar\.gz$" &
install_nvtop &
install_rex &

wait

success "[Github APP] Done"
