#!/usr/bin/env python3
"""Download files of this machine to the desktop that runs rexterm (its /tmp).

  rex-download FILE...

In a Rex pane, rexterm fetches each file through the Rex server
(download_begin) and says where it put it. Also inside tmux.
"""
import base64, json, os, sys, uuid

def main():
    paths = [os.path.abspath(os.path.expanduser(p)) for p in sys.argv[1:]]
    if not paths or any(p in ('-h', '--help') for p in sys.argv[1:]):
        print(__doc__.strip());return 0 if paths else 2
    missing = [p for p in paths if not os.path.isfile(p)]
    if missing:
        print('rex-download: not a file: ' + ', '.join(missing), file=sys.stderr);return 1
    value = base64.b64encode(json.dumps({'paths': paths, 'id': str(uuid.uuid4())}).encode()).decode()
    seq = '\033]1337;SetUserVar=WEZTERM_DOWNLOAD=%s\007' % value
    if os.environ.get('TMUX'):
        seq = '\033Ptmux;' + seq.replace('\033', '\033\033') + '\033\\'
    with open('/dev/tty', 'w') as tty:
        tty.write(seq)
    print('rex-download: asked rexterm for %d file(s); they go to its /tmp' % len(paths))
    return 0

sys.exit(main())
