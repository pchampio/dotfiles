#!/usr/bin/env bash
# List processes using swap, sorted from least to most (largest last).
# Usage: swapViewer [-a] [-w] [N]
#   N    show only the top N processes
#   -a   show all processes (default: top processes that hold 90% of the swap)
#   -w   do not cut lines to the terminal width
# Run with sudo to see processes of other users.

limit=0
percent=90
width=0
[[ -t 1 ]] && width=$(tput cols 2>/dev/null || echo 0)

for arg in "$@"; do
  case $arg in
    -a) percent=100 ;;
    -w) width=0 ;;
    -h|--help) sed -n '2,7p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *[!0-9]*|'') echo "swapViewer: invalid argument: $arg" >&2; exit 1 ;;
    *) limit=$arg ;;
  esac
done

for status in /proc/[0-9]*/status; do
  line=$(awk '
    /^Name:/   { name = $2 }
    /^Pid:/    { pid = $2 }
    /^Uid:/    { uid = $2 }
    /^VmSwap:/ { swap = $2 }
    END { if (swap > 0) print swap, pid, uid, name }
  ' "$status" 2>/dev/null) || continue
  [[ -z $line ]] && continue
  read -r swap pid uid name <<<"$line"
  args=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null)
  printf '%s %s %s %s\n' "$swap" "$pid" "$uid" "${args:-[$name]}"
done | sort -k1,1nr | awk -v limit="$limit" -v percent="$percent" -v width="$width" '
  function human(kb) {
    if (kb >= 1048576) return sprintf("%.1fG", kb / 1048576)
    if (kb >= 1024)    return sprintf("%.1fM", kb / 1024)
    return kb "K"
  }
  { line[NR] = $0; total += $1 }
  END {
    shown = 0
    for (n = 1; n <= NR; n++) {
      if (limit > 0 && n > limit) break
      if (percent < 100 && shown >= total * percent / 100) break
      split(line[n], f, " ")
      shown += f[1]
    }
    n--
    for (i = n; i >= 1; i--) {
      split(line[i], f, " ")
      if (!(f[3] in users)) {
        cmd = "id -nu " f[3] " 2>/dev/null"
        u = ""; cmd | getline u; close(cmd)
        users[f[3]] = (u != "" ? u : f[3])
      }
      args = line[i]
      sub(/^[^ ]+ [^ ]+ [^ ]+ /, "", args)
      out = sprintf("%8s  %8s  %-12s  %s", human(f[1]), f[2], users[f[3]], args)
      if (width > 3 && length(out) > width) out = substr(out, 1, width - 3) "..."
      print out
    }
    rule = ""
    for (j = 0; j < (width > 0 ? width : 80); j++) rule = rule "-"
    print rule
    printf "%8s  %8s  %-12s  %s\n", "SWAP", "PID", "USER", "COMMAND"
    hidden = NR - n
    if (hidden > 0)
      printf "%8s  total (%s in %d other processes not shown, use -a)\n", human(total), human(total - shown), hidden
    else
      printf "%8s  total\n", human(total)
  }
'
